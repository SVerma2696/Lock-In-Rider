# Python virtual environment
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# PyInstaller build output (from build.bat)
build/
dist/
*.spec

# The .ico/.icns app icon files are generated from lock_in/assets/app_icon.png
# right before a build (see build.bat and release.yml) — no need to commit
# the generated copies, just the one source picture.
lock_in_icon.ico
lock_in_icon.icns

# Editor / OS clutter
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local copies of this repo that Claude Code makes on your own machine
# while working on a branch (a "worktree") -- these live only on your
# computer and were never meant to be checked in. Without this line,
# one of them could accidentally get committed as a giant duplicate
# copy of the whole project.
.claude/worktrees/

# Output from the /graphify tool (knowledge-graph explorer) -- a local
# helper for browsing this codebase, not part of the app. Regenerates
# on demand, so there's nothing here worth checking in.
graphify-out/

# App data (settings, trained model, training data) — this lives in
# %APPDATA%\Lock In\ on Windows, not in this project folder, so it
# normally won't show up here. This is just a safety net in case any
# of it ever gets created locally.
config.json
model.json
observations.jsonl
tasks.json
sessions.jsonl
lockin_training_data.csv
app_icon.ico
app_icon_square.png

# Safety net for the auto-updater's temp files, in case anything ever
# runs from inside this folder during manual testing -- the real thing
# always downloads and unpacks in the OS temp folder, never this one.
*.old
lockin_update_tmp/
